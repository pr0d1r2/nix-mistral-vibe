amends "pkl/Config.pkl"

// Seeded by `pklith seed`; yours to edit. The steps come from hk.pklith.pkl,
// which `pklith gen` and `pklith lay` write from .pklith: shape them here
// (excludes, depends) by amending a step by its id.
import "hk.pklith.pkl" as generated

/// Vendored verbatim: hk's schema and its provenance note. An edit would
/// silently fork them, so no fixer or linter touches them, as in pklith.
local vendored = List("pkl/**")

local fast = (generated.steps) {
  ["trailing-whitespace"] { exclude = vendored }
  ["final-newline"] { exclude = vendored }
  ["line-endings"] { exclude = vendored }
  ["ripsecrets"] { exclude = vendored }
  ["markdownlint"] { exclude = vendored }
}

local all = (fast) { ...generated.push }

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = all
  }
}
